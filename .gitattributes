# ---------------------------------------------------------------------------
# Thunderbird — Git LFS + line-ending configuration
#
# Anything matched by an "filter=lfs" line is stored in Git LFS: the repo holds
# a small text pointer, the real bytes live on the LFS server.
#
# The "lockable" flag marks files that CANNOT be merged. Run
#   git lfs lock <file>     before you start working on one
#   git lfs unlock <file>   when you push
# Everyone else sees the file as read-only until you unlock it.
# ---------------------------------------------------------------------------

# Normalize line endings for ordinary text files (scripts, notes, configs).
* text=auto

# --- 3D scene files (unmergeable — always lock before editing) --------------
*.ma      filter=lfs diff=lfs merge=lfs -text lockable
*.mb      filter=lfs diff=lfs merge=lfs -text lockable
*.max     filter=lfs diff=lfs merge=lfs -text lockable
*.c4d     filter=lfs diff=lfs merge=lfs -text lockable
*.blend   filter=lfs diff=lfs merge=lfs -text lockable
*.lxo     filter=lfs diff=lfs merge=lfs -text lockable
*.hip     filter=lfs diff=lfs merge=lfs -text lockable
*.hipnc   filter=lfs diff=lfs merge=lfs -text lockable

